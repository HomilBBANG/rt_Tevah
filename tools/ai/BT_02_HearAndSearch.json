{
 "schema_version": 2,
 "asset_type": "behavior_tree",
 "id": "BT_02_HearAndSearch",
 "domain": "field",
 "blackboard_id": "BB_Infected",
 "battle_on_contact": true,
 "description": "실습 템플릿 2 (기획 v2.0 §12): 소리 감지 Service(UpdateNoise) — 달리기·문 소리를 들으면(HasHeardNoise, Lower Priority) 순찰·수색을 멈추고 그곳을 확인. 우선순위: 전투 > 추격 > 소리 확인 > 마지막 위치 수색 > 순찰. 연습: Investigate 의 Observer Aborts 를 None 으로 바꾸고 디버거로 차이 보기",
 "root_id": "root",
 "nodes": [
  {
   "id": "root",
   "kind": "Root",
   "children": [
    "ai_root"
   ]
  },
  {
   "id": "ai_root",
   "kind": "Selector",
   "name": "AI Root",
   "children": [
    "engage",
    "chase",
    "investigate",
    "search",
    "patrol"
   ],
   "services": [
    {
     "type": "UpdatePerception",
     "interval": 0.2,
     "random_deviation": 0.0,
     "run_on_activation": true
    },
    {
     "type": "UpdateNoise",
     "interval": 0.2,
     "random_deviation": 0.0,
     "run_on_activation": true
    }
   ]
  },
  {
   "id": "engage",
   "kind": "Sequence",
   "name": "Engage",
   "children": [
    "battle"
   ],
   "decorators": [
    {
     "type": "Blackboard",
     "name": "CanSeePlayer",
     "key": "HasLineOfSight",
     "operator": "is_set",
     "observer_aborts": "Both"
    },
    {
     "type": "Blackboard",
     "name": "InEngageRange",
     "key": "DistanceToTarget",
     "operator": "<=",
     "value": 0.6,
     "observer_aborts": "Both"
    }
   ]
  },
  {
   "id": "battle",
   "kind": "Task",
   "task_type": "EnterTurnBattle",
   "params": {}
  },
  {
   "id": "chase",
   "kind": "Sequence",
   "name": "Chase",
   "children": [
    "move_to_target"
   ],
   "decorators": [
    {
     "type": "Blackboard",
     "name": "CanSeePlayer",
     "key": "HasLineOfSight",
     "operator": "is_set",
     "observer_aborts": "Both"
    }
   ]
  },
  {
   "id": "move_to_target",
   "kind": "Task",
   "task_type": "MoveTo",
   "params": {
    "target_key": "TargetLocation",
    "run": true,
    "acceptance": 0.3
   }
  },
  {
   "id": "search",
   "kind": "Sequence",
   "name": "Search",
   "children": [
    "search_last"
   ],
   "decorators": [
    {
     "type": "Blackboard",
     "name": "HasLastSeen",
     "key": "HasLastKnownLocation",
     "operator": "is_set",
     "observer_aborts": "Self"
    }
   ]
  },
  {
   "id": "search_last",
   "kind": "Task",
   "task_type": "SearchLastPosition",
   "params": {
    "destination_key": "LastKnownLocation",
    "seconds_key": "SearchDuration",
    "clear_key": "HasLastKnownLocation"
   }
  },
  {
   "id": "patrol",
   "kind": "Task",
   "task_type": "Patrol",
   "name": "Patrol",
   "params": {}
  },
  {
   "id": "investigate",
   "kind": "Sequence",
   "name": "Investigate (소리 확인)",
   "children": [
    "forget_noise",
    "move_noise",
    "listen"
   ],
   "decorators": [
    {
     "type": "Blackboard",
     "name": "HeardNoise",
     "key": "HasHeardNoise",
     "operator": "is_set",
     "observer_aborts": "LowerPriority"
    }
   ]
  },
  {
   "id": "move_noise",
   "kind": "Task",
   "task_type": "MoveTo",
   "params": {
    "target_key": "NoiseLocation",
    "run": false,
    "acceptance": 0.4
   }
  },
  {
   "id": "listen",
   "kind": "Task",
   "task_type": "Wait",
   "params": {
    "seconds": 1.5
   }
  },
  {
   "id": "forget_noise",
   "kind": "Task",
   "task_type": "ClearBlackboardValue",
   "params": {
    "key": "HasHeardNoise"
   }
  }
 ],
 "editor_layout": {}
}